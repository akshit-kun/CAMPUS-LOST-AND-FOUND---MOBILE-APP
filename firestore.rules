rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Items collection
    match /items/{itemId} {
      // Anyone authenticated can read items
      allow read: if request.auth != null;

      // Authenticated users can create items
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['name', 'description', 'type', 'status'])
        && request.resource.data.name is string
        && request.resource.data.description is string;

      // Only the poster or admin can update items
      allow update: if request.auth != null;

      // Only the poster can delete
      allow delete: if request.auth != null
        && resource.data.postedByEmail == request.auth.token.email;
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Matches collection (AI-generated)
    match /matches/{matchId} {
      // Authenticated users can read matches
      allow read: if request.auth != null;

      // Only Cloud Functions (admin SDK) should create matches
      // Client can only update 'dismissed' field
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissed']);

      // No client-side create or delete
      allow create: if false;
      allow delete: if false;
    }
    
    // Moderation requests queue (AI spam check)
    match /moderation_requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['name', 'description', 'location', 'userEmail', 'timestamp']);
      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
